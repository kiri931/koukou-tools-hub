---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import '../styles/global.css';

// T6（エラー）。/tools/存在しないURL などで実際に出る。
// パンくずは URL から作ると「存在しないページ名」が並ぶので、出さない（crumbs を空にする）。
// 行き先は以前と同じ2つ（ホーム・ツール一覧）。
---

<Layout title="ページが見つかりません - 高校情報" noindex={true} width="text" crumbs={[]}>
  <main class="kj-container kj-container--text th-page not-found">
    <PageHead
      label="404"
      title="ページが見つかりません"
      lead="お探しのページは削除されたか、URLが変更された可能性があります。"
    />
    <nav aria-label="ほかのページへ" class="not-found-links">
      <a href="/" class="kj-btn kj-btn--primary kj-btn--lg">ホームへ戻る</a>
      <a href="/tools/" class="kj-btn kj-btn--lg">ツール一覧を見る</a>
    </nav>
  </main>
</Layout>

<style>
  /* パンくずが無い分、上に余白をとる */
  .not-found {
    padding-top: 48px;
    min-height: 50vh;
  }
  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
