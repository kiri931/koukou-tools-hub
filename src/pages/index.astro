---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { LinkCard } from '../components/LinkCard';
import { SectionHeading } from '../components/SectionHeading';
import { sections } from '../lib/site-links';
import '../styles/global.css';

// カードは src/lib/site-links.ts から作る。
// 以前はこのファイルに同じ形の markup が16回コピーされていて、357行あった。
---

<Layout
	title="高校情報 - Webツール集"
	description="ブラウザだけで動くWebツール集。タイピング練習・顔モザイク・PDFマージ・タイムスケジューラ・プレゼンガイドなど、授業や学習に役立つツールを無料で公開しています。"
>
	{/* T2（一覧・入口）。このハブのルートは本番では配信しない（/ はメインサイト）が、
	    ローカルで開いたときに同じ型で見えるようにしておく */}
	<main class="kj-container th-page">
		<PageHead
			title="高校情報"
			lead="学習向けツールと業務ツール、サポート情報をカテゴリ別にまとめています。"
		/>

		{
			sections.map((section) => (
				<section>
					<SectionHeading title={section.label} desc={section.desc} />
					<div class="kj-grid">
						{section.items.map((item) => (
							<LinkCard
								href={item.href}
								label={item.label}
								desc={item.desc}
								icon={item.icon}
								accent={item.accent}
							/>
						))}
					</div>
				</section>
			))
		}

		<section class="th-about kj-card">
			<h2>このサイトについて</h2>
			<p>
				このサイトはAIで作っています。<br />
				そのため制作は早いですが、細かい部分が甘いところもあります。<br />
				「こんなのあったらいいな」を元に、情報科の授業や学習に役立つツールを作っています。実験的な機能も含まれるため、授業でご利用の際はご確認のうえお使いください。
			</p>
			<p>モバイル版には対応していないものもあるのでご注意ください。</p>

			<hr class="about-rule" />

			<p>
				このサイト内の多くの処理はブラウザ上で完結する設計にしています。<br />
				入力内容や画像データを運営者側で保存することは基本的に行っていません。
			</p>
			<p class="text-[var(--color-text-muted)]">
				※サーバー契約上、アクセス元IPなどの一般的なログは自動的に記録されますが、個別に分析・利用する目的はありません。
			</p>
			<p class="text-[var(--color-text-muted)]">
				児童・生徒の個人情報を収集する目的で運営しているサイトではありません。
			</p>

			<hr class="about-rule" />

			<p>
				アクセス数が増え、Cloudflareの無料枠を超えた場合はバナー広告を表示する可能性があります。<br />
				その際、広告配信サービスにより閲覧履歴等に基づく最適化広告が表示される場合があります。
			</p>

			<hr class="about-rule" />

			<p>
				実験的に作っている部分もあるため、授業等で利用される場合はご理解の上でお願いいたします。
			</p>
			<p>
				不具合や改善点があれば、サポートよりご連絡ください。<br />
				作るスピードだけは速いです。
			</p>
		</section>
	</main>
</Layout>

<style>
	/* 装飾の区切り線（意味を持たない線なので --kj-divider） */
	.about-rule {
		margin: 8px 0;
		border: 0;
		border-top: 1px solid var(--kj-divider);
	}
</style>
