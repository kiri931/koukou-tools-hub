---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import GdDrill from "../../features/gd-kentei/components/GdDrill";
import "../../styles/global.css";

// safe: まちがえた問題の記録は localStorage にだけ置き、送信はしていない
// （GdDrill.tsx に fetch は無く、画面にも「サーバへは送りません」と書いてある）。
---

<Layout
  title="グラフィックデザイン検定ドリル - 高校情報"
  description="グラフィックデザイン検定の4択ドリル。企画・写真・編集レイアウト・写真製版・印刷・製本の6分野を、級で絞って1問ずつ解けます。まちがえた問題だけをやり直せます。"
>
  <main class="kj-container th-page">
    <PageHead
      label="ツール"
      title="グラフィックデザイン検定ドリル"
      lead="1問ずつ答えて、その場で正誤と解説を見る練習です。問題はすべて書き下ろしたもので、過去問そのものではありません。"
      safe={true}
    >
      <p class="kj-no-print" style="margin: 0">
        <a href="/study/graphic-design/">グラフィックデザイン検定 対策へもどる</a>
      </p>
    </PageHead>
    <section aria-label="ツール本体" class="kj-tool-frame th-tool-body">
      <GdDrill client:only="react" />
    </section>
  </main>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'グラフィックデザイン検定ドリル',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web Browser',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
      inLanguage: 'ja-JP',
      url: 'https://koukou-jouhou.org/tools/gd-kentei/',
    })}
  />
</Layout>
