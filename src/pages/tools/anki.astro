---
import Layout from '../../layouts/Layout.astro';
import PageHead from '../../components/PageHead.astro';
import { AnkiApp } from '../../features/anki';
import '../../styles/global.css';
---

<Layout
  title="覚える君 - 高校情報"
  description="単語カードで記憶定着をサポートする暗記ツール。表裏形式のカードを作成・管理できます。ブラウザ上で動作。"
>
  <main class="kj-container th-page">
    <PageHead
      label="ツール"
      title="覚える君"
      lead="短答入力 × 分散復習（FSRS）で暗記を進める学習ツール"
    />
    <section aria-label="ツール本体" class="kj-tool-frame th-tool-body">
      <AnkiApp client:only="react" />
    </section>
  </main>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: '覚える君',
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Web Browser',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
      inLanguage: 'ja-JP',
      url: 'https://koukou-jouhou.org/tools/anki',
    })}
  />
</Layout>
