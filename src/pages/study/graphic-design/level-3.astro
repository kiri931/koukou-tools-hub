---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/Header";
import GdBackLink from "../../../components/GdBackLink.astro";
import GdLevelGuide from "../../../features/gd-kentei/components/GdLevelGuide";
import { levelGuides } from "../../../features/gd-kentei/data/levels";
import "../../../styles/global.css";
---

<Layout
  title="3級で問われること - グラフィックデザイン検定 - 高校情報"
  description="グラフィックデザイン検定3級の出題の傾向。3級は用語型が62%。用語を覚えれば届きます。合格率は4年とも65〜78%。想定は高校1学年終了程度、筆記60分のみ。"
>
  <div class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <Header client:load currentPath={Astro.url.pathname} />
    <GdBackLink />
    <GdLevelGuide guide={levelGuides["3"]} client:only="react" />
  </div>
</Layout>
