---
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";
import GdLesson from "../../../features/gd-kentei/components/GdLesson";
import { bindingLesson as lesson } from "../../../features/gd-kentei/data/lessons/binding";
import { getField } from "../../../features/gd-kentei/lib/fields";
import "../../../styles/global.css";

// 見出し（h1）と説明はここで SSR する。GdLesson は本文だけを出す。
// パンくずの名前（分野名）は Layout の対応表に無いので、ここで渡す。
const field = getField(lesson.field);
---

<Layout
  title="製本 - グラフィックデザイン検定 - 高校情報"
  description="グラフィックデザイン検定の「製本」分野の解説。上製本と並製本の違い、紙の目、折丁と台割、綴じと断裁。問14・問15で問われる製本の用語を整理しました。"
  width="text"
  crumbs={[{ name: "グラフィックデザイン検定", href: "/study/graphic-design/" }, { name: field.label }]}
>
  <main class="kj-container kj-container--text th-page">
    <PageHead label="学習ガイド" title={field.label} lead={lesson.scope} />
    <GdLesson lesson={lesson} client:only="react" />
  </main>
</Layout>
