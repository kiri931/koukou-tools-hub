---
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";
import { LinkCard } from "../../../components/LinkCard";
import { fields } from "../../../features/gd-kentei/lib/fields";
import { lessons } from "../../../features/gd-kentei/data/lessons";
import { levelGuides } from "../../../features/gd-kentei/data/levels";
import { terms } from "../../../features/gd-kentei/data/terms";
import "../../../styles/global.css";

// T2（入口）。説明の文章が主で、カードは十数枚なので、幅は記事と同じ text にした
// （wide だと説明の1行が長くなりすぎる）。カードの色分けは kj の変数に無い16進だったのでやめた。

const cards = fields.map((field) => ({
	href: `/study/graphic-design/${field.id}/`,
	label: field.label,
	desc: `${field.desc} 本番では問${field.questionNumbers.join("・問")}。用語${terms.filter((t) => t.field === field.id).length}語。`,
	sections: lessons[field.id].sections.length,
}));
---

<Layout
	title="グラフィックデザイン検定 対策 - 高校情報"
	description="グラフィックデザイン検定（全国工業高等学校長協会）の対策教材。企画・写真・編集レイアウト・写真製版・印刷・製本の6分野の解説と、233語の用語辞典。"
	width="text"
>
	<main class="kj-container kj-container--text th-page">
		<PageHead label="学習ガイド" title="グラフィックデザイン検定 対策">
			<p class="kj-lead">
				筆記試験は問1から問15まであり、そのうち<strong>10題を選んで解答</strong>します（1題5設問なので50設問）。制限時間60分、60点以上で合格です。
				11題以上に手を付けると失格になるので、どの分野で取るかをあらかじめ決めておくのが有利です。
			</p>
			<p class="kj-lead">問番号と分野の対応は決まっています。まず得意な分野を作り、そこから広げてください。</p>
		</PageHead>

		<section class="th-gd-section" aria-labelledby="gd-levels">
			<h2 id="gd-levels" class="kj-heading">級ごとの案内</h2>
			<p class="th-gd-text">
				級が上がるほど、用語を答える設問が減り、記述の正誤を見分ける設問が増えます。
				受ける級のページから読んでください。
			</p>
			<div class="kj-grid">
				{
					(["3", "2", "1"] as const).map((level) => (
						<LinkCard
							href={`/study/graphic-design/level-${level}/`}
							label={`${levelGuides[level].label}で問われること`}
							desc={`${levelGuides[level].standard}。${levelGuides[level].format} 合格率は直近4年で${Math.min(...levelGuides[level].results.map((r) => r.passRate))}〜${Math.max(...levelGuides[level].results.map((r) => r.passRate))}%。`}
						/>
					))
				}
			</div>
		</section>

		<section class="th-gd-section" aria-labelledby="gd-fields">
			<h2 id="gd-fields" class="kj-heading">分野ごとの解説</h2>
			<div class="kj-grid">
				{cards.map((card) => <LinkCard href={card.href} label={card.label} desc={card.desc} />)}
			</div>
		</section>

		<section class="th-gd-section" aria-labelledby="gd-jitsugi">
			<h2 id="gd-jitsugi" class="kj-heading">1級を受ける人へ</h2>
			<LinkCard
				href="/study/graphic-design/jitsugi/"
				label="1級実技の練習課題"
				desc="指示書・指示図・支給データ・自己採点チェックリストの一式。テーマは「日本の伝統色」。過去問ではなく書き下ろしの類題です。"
			/>
		</section>

		<section class="th-gd-section" aria-labelledby="gd-tools">
			<h2 id="gd-tools" class="kj-heading">まとめて調べる</h2>
			<div class="kj-grid">
				<LinkCard
					href="/tools/gd-kentei/"
					label="4択ドリル"
					desc="書き下ろした135問。分野と級で絞って1問ずつ解け、まちがえた問題だけをやり直せます。"
				/>
				<LinkCard
					href="/study/graphic-design/glossary/"
					label="用語辞典"
					desc={`6分野の用語${terms.length}語。読み・分野・級で絞り込めます。`}
				/>
			</div>
		</section>

		<p class="th-gd-note">
			出題の傾向は、公益社団法人 全国工業高等学校長協会が公開している<a
				href="https://zenkoukyo.or.jp/index_kentei/exam_result/"
				target="_blank"
				rel="noreferrer noopener">検定試験の実施結果</a
			>（第26〜30回）をもとにしています。ここに載せている文章と例はすべて書き下ろしたもので、過去問そのものは掲載していません。
		</p>
	</main>
</Layout>

<style>
	/* 見出し → 説明 → カード の縦の並び。色と文字は kj（.kj-body）のまま */
	.th-gd-section { display: flex; flex-direction: column; gap: 16px; }
	.th-gd-text { margin: 0; line-height: var(--kj-leading-body); }
	.th-gd-note { margin: 0; color: var(--color-text-muted); line-height: var(--kj-leading-body); }
</style>
