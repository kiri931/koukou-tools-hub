---
import Layout from "../../../layouts/Layout.astro";
import { Header } from "../../../components/Header";
import GdBackLink from "../../../components/GdBackLink.astro";
import GdLevelGuide from "../../../features/gd-kentei/components/GdLevelGuide";
import { levelGuides } from "../../../features/gd-kentei/data/levels";
import "../../../styles/global.css";
---

<Layout
  title="1級で問われること - グラフィックデザイン検定 - 高校情報"
  description="グラフィックデザイン検定1級の出題の傾向。1級は記述判定型が64%。筆記に加えて90分の実技があります。合格率は8〜18%。準1級は受検枠ではなく1級の2段階目の合格ラインです。"
>
  <div class="min-h-screen bg-slate-50 dark:bg-slate-950">
    <Header client:load currentPath={Astro.url.pathname} />
    <GdBackLink />
    <GdLevelGuide guide={levelGuides["1"]} client:only="react" />
  </div>
</Layout>
