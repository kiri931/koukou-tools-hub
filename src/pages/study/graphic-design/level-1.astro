---
import Layout from "../../../layouts/Layout.astro";
import PageHead from "../../../components/PageHead.astro";
import GdLevelGuide from "../../../features/gd-kentei/components/GdLevelGuide";
import { levelGuides } from "../../../features/gd-kentei/data/levels";
import "../../../styles/global.css";

// 見出し（h1）はここで SSR する。GdLevelGuide は本文だけを出す。
// 想定の程度と試験の形は本文の最初の表に出るので、説明（lead）には重ねない。
const guide = levelGuides["1"];
---

<Layout
  title="1級で問われること - グラフィックデザイン検定 - 高校情報"
  description="グラフィックデザイン検定1級の出題の傾向。1級は記述判定型が64%。筆記に加えて90分の実技があります。合格率は8〜18%。準1級は受検枠ではなく1級の2段階目の合格ラインです。"
  width="text"
>
  <main class="kj-container kj-container--text th-page">
    <PageHead label="学習ガイド" title={`${guide.label}で問われること`} />
    <GdLevelGuide guide={guide} client:only="react" />
  </main>
</Layout>
