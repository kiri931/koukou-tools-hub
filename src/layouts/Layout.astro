---
import GoogleAnalytics from '../../../shared/src/astro/GoogleAnalytics.astro';

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	noindex?: boolean;
	/**
	 * 共通ヘッダーの種類（site-bar.js）。ふつうは full（T1〜T4・T6）。
	 * 画面いっぱいを使うツール（T5）だけ slim。slim はフッターを出さない。
	 */
	siteBar?: 'full' | 'slim';
	/** パンくずの幅。記事・案内は本文と同じ幅（text）、一覧・ツールは広い幅（wide） */
	width?: 'text' | 'wide';
	/** 画面に出すパンくず。省略するとURLから作る（実体の無い /study/・/support/ は飛ばす） */
	crumbs?: { name: string; href?: string }[];
}

const {
	title = '高校情報',
	description,
	canonical,
	ogImage,
	noindex,
	siteBar = 'full',
	width = 'wide',
	crumbs,
} = Astro.props;
const siteUrl = 'https://koukou-jouhou.org';
// このサイトは末尾スラッシュ付きURLが実体(Cloudflare Assets が付いていないURLを307でこちらへ飛ばす)。
// canonical が末尾スラッシュ無しのままだと「リダイレクトされるURL」を指すことになり、
// Google に「代替ページ(適切な canonical タグあり)」として弾かれる。
// メインサイトの koukou-jouhou/src/layouts/Layout.astro と同じ正規化をここでも行う。
const withTrailingSlash = (pathname: string) =>
	pathname.endsWith('/') || /\.[a-z0-9]+$/i.test(pathname) ? pathname : `${pathname}/`;
const canonicalUrl = new URL(
	withTrailingSlash(new URL(canonical ?? Astro.url.pathname, siteUrl).pathname),
	siteUrl,
).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteUrl).href : null;
const breadcrumbNameMap: Record<string, string> = {
	about: '運営者情報',
	tools: 'ツール',
	support: 'サポート',
	anki: '覚える君',
	'face-mosaic': '顔モザイクツール',
	'pdf-merge': 'PDFマージ',
	'pdf-viewer': 'PDF参照モード',
	viewer: 'PDFビューワー',
	'scientific-calculator': '関数電卓',
	study: '学習',
	'equation-transformation': '等式の変形テスト',
	'feature-request': '機能リクエスト',
	'calc-drill': '計算技術検定ドリル',
	'graphic-design': 'グラフィックデザイン検定',
	glossary: '用語辞典',
	'level-3': '3級',
	'level-2': '2級',
	'level-1': '1級',
	'gd-kentei': 'グラフィックデザイン検定ドリル',
	jitsugi: '1級実技の練習課題',
	'privacy-policy': 'プライバシーポリシー',
	'terms-of-use': '利用規約',
	'time-schedule': 'タイムスケジューラ',
	'typing-japanese': 'タイピング練習',
	planning: '企画・マーケティング・デザイン',
	photo: '写真',
	layout: '編集レイアウト',
	prepress: '写真製版',
	printing: '印刷',
	binding: '製本',
};


const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = pathSegments.map((segment, index) => {
	const name = breadcrumbNameMap[segment] ?? decodeURIComponent(segment);
	const item = new URL(`/${pathSegments.slice(0, index + 1).join('/')}`, siteUrl).href;
	return { name, item, position: index + 2 };
});

// 画面に出すパンくず。JSON-LD（上）とは別に作る。
// /study/ と /support/ はページの実体が無く、worker が別のページへ 301 で飛ばすので、
// 画面のパンくずには出さない（押すと別のページに着いてしまう）。
const visibleCrumbs: { name: string; href?: string }[] =
	crumbs ??
	pathSegments
		.map((segment, index) => ({ segment, index }))
		.filter(({ segment, index }) => !(index === 0 && (segment === 'study' || segment === 'support')))
		.map(({ segment, index }) => ({
			name: breadcrumbNameMap[segment] ?? decodeURIComponent(segment),
			href: index === pathSegments.length - 1 ? undefined : `/${pathSegments.slice(0, index + 1).join('/')}/`,
		}));

const breadcrumbJsonLd =
	breadcrumbItems.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: [
					{
						'@type': 'ListItem',
						position: 1,
						name: 'ホーム',
						item: `${siteUrl}/`,
					},
					...breadcrumbItems.map((crumb) => ({
						'@type': 'ListItem',
						position: crumb.position,
						name: crumb.name,
						item: crumb.item,
					})),
				],
		  }
		: null;
---
<!doctype html>
<html lang="ja" data-site-bar={siteBar}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<GoogleAnalytics />
		<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8375913886731430" crossorigin="anonymous"></script>
		{description ? <meta name="description" content={description} /> : null}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description ?? ''} />
		<meta property="og:site_name" content="高校情報" />
		<meta property="og:locale" content="ja_JP" />
		{ogImageUrl ? <meta property="og:image" content={ogImageUrl} /> : null}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: "高校情報",
				url: siteUrl,
				description: "高校生向けWebツール集",
				inLanguage: "ja-JP",
			})}
		/>
		{breadcrumbJsonLd ? (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		) : null}
		<title>{title}</title>
		<script is:inline>
			// 明暗の初期値を描画前に <html> へ写す（ちらつき防止）。切り替えボタンは site-bar.js が出す。
			// kj.css は html.dark / html.light と OS の設定を、Tailwind の dark: は html.dark を見るので、
			// どちらか一方のクラスを必ず付けて、両者の判定を一致させる。
			(() => {
				const root = document.documentElement;
				const media = window.matchMedia("(prefers-color-scheme: dark)");
				const saved = () => {
					try { return localStorage.getItem("theme"); } catch { return null; }
				};
				const apply = () => {
					const s = saved();
					const dark = s === "dark" || (s !== "light" && media.matches);
					root.classList.toggle("dark", dark);
					root.classList.toggle("light", !dark);
				};
				apply();
				media.addEventListener("change", () => { if (!saved()) apply(); });
			})();
		</script>
		<!-- 高校情報の共通CSS。色・文字・部品はここの変数を使う（本体はメインサイトの public/kj/kj.css） -->
		<link rel="stylesheet" href="/kj/kj.css" />
		<!-- 共通ヘッダー・フッター（本体はメインサイトの public/site-bar.js）。
		     自前の Header.tsx とフッターはやめた（2026-09-27、サイト全体で見た目をそろえる決定）。 -->
		<script src="/site-bar.js" defer></script>
	</head>
	<body class="kj-body">
		{visibleCrumbs.length > 0 ? (
			<nav
				aria-label="パンくずリスト"
				class:list={['kj-container kj-no-print', width === 'text' && 'kj-container--text']}
			>
				<ol class="kj-breadcrumb">
					<li><a href="/">トップ</a></li>
					{visibleCrumbs.map((crumb) =>
						crumb.href ? (
							<li><a href={crumb.href}>{crumb.name}</a></li>
						) : (
							<li aria-current="page">{crumb.name}</li>
						),
					)}
				</ol>
			</nav>
		) : null}
		<slot />
	</body>
</html>
